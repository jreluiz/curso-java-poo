---
config:
  theme: base
  # fontFamily precisa ser chave de topo — dentro de themeVariables é ignorada
  fontFamily: "Helvetica Neue, Helvetica, Arial, sans-serif"
  themeVariables:
    fontSize: 23px
    lineColor: "#e76f00"
    primaryColor: "#fdf1e6"
    primaryTextColor: "#1a1a1a"
    primaryBorderColor: "#e76f00"
    edgeLabelBackground: "#fdfdfb"
  flowchart:
    nodeSpacing: 65
    padding: 22
---
flowchart LR
    FONTE["<b>Aluno.java</b><br><br>você escreve<br><i>código-fonte</i>"]
    BYTE["<b>Aluno.class</b><br><br>bytecode<br><i>ilegível para humanos</i>"]
    RUN["<b>programa<br>rodando</b>"]

    FONTE -->|"<b>javac</b><br>compila"| BYTE
    BYTE -->|"<b>java</b><br>a JVM executa"| RUN

    classDef caixa fill:#fdf1e6,stroke:#e76f00,stroke-width:4px,color:#1a1a1a
    classDef final fill:#e76f00,stroke:#b35600,stroke-width:4px,color:#ffffff
    class FONTE,BYTE caixa
    class RUN final

    linkStyle 0,1 stroke:#e76f00,stroke-width:3.5px
